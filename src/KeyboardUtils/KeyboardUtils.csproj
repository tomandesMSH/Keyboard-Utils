<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProjectReference doesn't auto-copy a referenced project's native content (that's a NuGet-only trick via
         runtimes/win-x64/native), so interception.dll needs copying explicitly here too. -->
    <None Include="..\MacroKeyboard\native\interception.dll" Link="interception.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\install-interception.exe" Link="install-interception.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.18" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.*" />
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroKeyboard\MacroKeyboard.csproj" />
  </ItemGroup>

</Project>
