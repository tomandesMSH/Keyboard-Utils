<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.2.0</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- dotnet publish makes one KeyboardUtils.exe (the libraries, native ones too, inside it): the website's
         download button fetches just that file. It still needs the .NET 10 Desktop Runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Next to the app in a build (DriverSetupForm runs it from there); not in the published single file, which
         carries it inside - with its LGPL licence - and writes it out when the driver is installed. -->
    <None Include="..\..\tools\install-interception.exe" Link="install-interception.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="..\..\tools\install-interception.exe" LogicalName="KeyboardUtils.install-interception.exe" />
    <EmbeddedResource Include="..\..\tools\Interception-LGPL-3.0.txt" LogicalName="KeyboardUtils.Interception-LGPL-3.0.txt" />
    <!-- The same icon for the windows (title bar / taskbar), loaded by AppIcon. -->
    <EmbeddedResource Include="Resources\app.ico" LogicalName="KeyboardUtils.app.ico" />
  </ItemGroup>

  <!-- DryWetMidi ships a macOS library too; a Windows app has no use for it next to its .exe. -->
  <Target Name="DropMacLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dylib'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The unit tests (tests/KeyboardUtils.Tests) test the internal classes. -->
    <InternalsVisibleTo Include="KeyboardUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.18" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.*" />
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: MacroKeyboard.dll is downloaded on demand (see Modules/), never bundled in the
         build - Private=false keeps it (and interception.dll) out of the output directory. -->
    <ProjectReference Include="..\MacroKeyboard\MacroKeyboard.csproj" Private="false" />
    <!-- Same for the chord detection add-on (Basic Pitch + ONNX Runtime): compile-time only, downloaded on demand. -->
    <ProjectReference Include="..\BasicPitch\BasicPitch.csproj" Private="false" />
  </ItemGroup>

</Project>
